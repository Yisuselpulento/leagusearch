---
import Layout from "../../layouts/Layout.astro";
import Spinner from "../../components/Spinner.astro";
import { fetchChampionDetails, fetchData, fetchMerakiChampion, getVersion } from "../../services/champs";
import { ddImg, DDRAGON_IMG } from "../../services/constants";

const { id } = Astro.params

const version = await getVersion()

let champ = null
if (id) {
  champ = await fetchChampionDetails(id)
}

// Enriquecimiento Meraki (puede ser null en los campeones más nuevos).
const meraki = id ? await fetchMerakiChampion(id) : null

export async function getStaticPaths() {
  const champs = await fetchData()
  return champs.map(champ => ({
    params: { id: champ.id }
  }))
}

const spellKeys = ['Q', 'W', 'E', 'R']

// Valoraciones de Meraki (escala 1-3) -> barras.
const ratingLabels = {
  damage: 'Daño', toughness: 'Resistencia', control: 'Control',
  mobility: 'Movilidad', utility: 'Utilidad', difficulty: 'Dificultad'
}
const ratings = meraki?.attributeRatings
  ? Object.entries(ratingLabels)
      .filter(([k]) => meraki.attributeRatings[k] != null)
      .map(([k, label]) => ({ label, value: meraki.attributeRatings[k] }))
  : []
const infoBars = champ ? [
  { label: 'Ataque', value: champ.info?.attack ?? 0 },
  { label: 'Defensa', value: champ.info?.defense ?? 0 },
  { label: 'Magia', value: champ.info?.magic ?? 0 },
  { label: 'Dificultad', value: champ.info?.difficulty ?? 0 },
] : []
const stats = champ?.stats ?? {}
const statList = [
  { label: 'Vida', value: Math.round(stats.hp) },
  { label: 'Recurso', value: `${Math.round(stats.mp)} ${champ?.partype ?? ''}` },
  { label: 'Daño de ataque', value: Math.round(stats.attackdamage) },
  { label: 'Armadura', value: Math.round(stats.armor) },
  { label: 'Resist. mágica', value: Math.round(stats.spellblock) },
  { label: 'Vel. movimiento', value: stats.movespeed },
  { label: 'Rango de ataque', value: stats.attackrange },
  { label: 'Regen. vida', value: stats.hpregen },
]

// DDragon incluye los CHROMAS dentro de skins (marcados con parentSkin), pero
// esos no tienen arte de loading (dan 403) -> se veian recuadros rotos/repetidos.
// Filtramos los chromas: solo skins reales (sin parentSkin).
const realSkins = (champ?.skins ?? []).filter(s => s.parentSkin === undefined)
---

<Layout title={champ ? champ.name : id}>
  <div class='flex flex-col gap-8 w-full md:p-16 p-3 pt-20 max-w-[1100px]'>
    {champ
      ? <Fragment>
        <a class='hover:text-indigo-500 dark:text-white text-gray-800 text-lg w-fit' href='/champs'>&larr; Atras</a>

        {/* HERO */}
        <div class="flex flex-col gap-5 relative shadow-lg rounded-lg overflow-hidden">
          <div class='bg-cover bg-center rounded-lg w-full h-full absolute opacity-60' style={{ backgroundImage: `url('${DDRAGON_IMG}/champion/splash/${champ.id}_0.jpg')` }}></div>
          <div class="bg-gradient-to-t from-black via-black/70 to-black/40 flex relative md:p-10 p-4 flex-col gap-6 text-white">
            <div class='flex gap-5 items-center flex-wrap'>
              <img
                class='border border-yellow-500 rounded h-[100px] w-[100px]'
                src={ddImg(version, 'champion', `${champ.id}.png`)}
                alt={champ.name}
              />
              <div class='flex flex-col gap-2'>
                <p class='text-3xl font-bold'>{champ.name}</p>
                <p class='text-lg text-gray-300 italic'>{champ.title}</p>
                <div class='flex flex-wrap gap-2'>
                  {champ.tags?.map(tag => (
                    <span class='text-xs px-2 py-1 rounded bg-blue-700 text-white'>{tag}</span>
                  ))}
                  <span class='text-xs px-2 py-1 rounded bg-slate-700 text-white'>{champ.partype}</span>
                </div>
              </div>
            </div>
            <p class='max-w-[800px] text-sm text-gray-200'>{champ.lore}</p>
          </div>
        </div>

        {/* ENRIQUECIMIENTO MERAKI (roles, tipo, precio, valoraciones) */}
        {meraki && (
          <div class='dark:bg-black/30 bg-gray-100 rounded-lg border dark:border-gray-800 border-gray-200 p-5 flex flex-col gap-4'>
            <div class='flex flex-wrap gap-x-8 gap-y-3 text-sm'>
              {meraki.roles?.length > 0 && (
                <div class='flex flex-col gap-1'>
                  <span class='text-gray-400'>Roles</span>
                  <div class='flex flex-wrap gap-2'>
                    {meraki.roles.map(r => <span class='text-xs px-2 py-1 rounded bg-blue-800/60 text-blue-100 capitalize'>{r.toLowerCase()}</span>)}
                  </div>
                </div>
              )}
              {meraki.attackType && (
                <div class='flex flex-col gap-1'>
                  <span class='text-gray-400'>Tipo de daño</span>
                  <span class='font-bold capitalize'>{meraki.attackType.toLowerCase()} · {meraki.adaptiveType?.replace('_DAMAGE','').toLowerCase()}</span>
                </div>
              )}
              {meraki.price && (
                <div class='flex flex-col gap-1'>
                  <span class='text-gray-400'>Precio</span>
                  <span class='font-bold'>{meraki.price.blueEssence} BE · {meraki.price.rp} RP</span>
                </div>
              )}
            </div>
            {ratings.length > 0 && (
              <div class='flex flex-col gap-2'>
                <span class='text-gray-400 text-sm'>Valoracion</span>
                <div class='grid grid-cols-2 sm:grid-cols-3 gap-x-6 gap-y-2'>
                  {ratings.map(r => (
                    <div class='flex items-center gap-2'>
                      <span class='w-24 text-xs text-gray-400'>{r.label}</span>
                      <div class='flex-1 h-2 rounded bg-gray-300 dark:bg-gray-700 overflow-hidden'>
                        <div class='h-full bg-indigo-500 rounded' style={`width:${(r.value / 3) * 100}%`}></div>
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            )}
          </div>
        )}

        {/* INFO BARS + STATS */}
        <div class='grid md:grid-cols-2 gap-6'>
          <div class='dark:bg-black/30 bg-gray-100 rounded-lg border dark:border-gray-800 border-gray-200 p-5 flex flex-col gap-3'>
            <h2 class='text-xl font-bold'>Perfil</h2>
            {infoBars.map(bar => (
              <div class='flex items-center gap-3'>
                <span class='w-24 text-sm text-gray-400'>{bar.label}</span>
                <div class='flex-1 h-2 rounded bg-gray-300 dark:bg-gray-700 overflow-hidden'>
                  <div class='h-full bg-blue-600 rounded' style={`width:${bar.value * 10}%`}></div>
                </div>
                <span class='w-8 text-right text-sm'>{bar.value}</span>
              </div>
            ))}
          </div>
          <div class='dark:bg-black/30 bg-gray-100 rounded-lg border dark:border-gray-800 border-gray-200 p-5'>
            <h2 class='text-xl font-bold mb-3'>Estadisticas base</h2>
            <div class='grid grid-cols-2 gap-x-6 gap-y-2 text-sm'>
              {statList.map(s => (
                <div class='flex justify-between border-b dark:border-gray-800 border-gray-200 py-1'>
                  <span class='text-gray-400'>{s.label}</span>
                  <span class='font-bold'>{s.value}</span>
                </div>
              ))}
            </div>
          </div>
        </div>

        {/* HABILIDADES */}
        <div class='flex flex-col gap-4'>
          <h2 class='text-2xl font-bold'>Habilidades</h2>
          {champ.passive && (
            <div class='flex gap-4 dark:bg-black/30 bg-gray-100 rounded-lg border dark:border-gray-800 border-gray-200 p-4'>
              <img class='w-[56px] h-[56px] rounded shrink-0' src={ddImg(version, 'passive', champ.passive.image.full)} alt={champ.passive.name} />
              <div class='flex flex-col gap-1'>
                <p class='font-bold'><span class='text-blue-500'>Pasiva</span> · {champ.passive.name}</p>
                <p class='text-sm text-gray-400' set:html={champ.passive.description}></p>
              </div>
            </div>
          )}
          {champ.spells?.map((spell, i) => (
            <div class='flex gap-4 dark:bg-black/30 bg-gray-100 rounded-lg border dark:border-gray-800 border-gray-200 p-4'>
              <img class='w-[56px] h-[56px] rounded shrink-0' src={ddImg(version, 'spell', spell.image.full)} alt={spell.name} />
              <div class='flex flex-col gap-1'>
                <p class='font-bold'><span class='text-blue-500'>{spellKeys[i]}</span> · {spell.name}</p>
                <div class='flex gap-4 text-xs text-gray-400'>
                  <span>Enfriamiento: {spell.cooldownBurn}s</span>
                  {spell.costBurn && spell.costBurn !== '0' && <span>Coste: {spell.costBurn}</span>}
                </div>
                <p class='text-sm text-gray-400' set:html={spell.description}></p>
              </div>
            </div>
          ))}
        </div>

        {/* TIPS */}
        {(champ.allytips?.length > 0 || champ.enemytips?.length > 0) && (
          <div class='grid md:grid-cols-2 gap-6'>
            {champ.allytips?.length > 0 && (
              <div class='dark:bg-black/30 bg-gray-100 rounded-lg border dark:border-gray-800 border-gray-200 p-5'>
                <h2 class='text-lg font-bold mb-2 text-green-500'>Consejos jugando con {champ.name}</h2>
                <ul class='list-disc pl-5 text-sm text-gray-400 flex flex-col gap-2'>
                  {champ.allytips.map(tip => <li>{tip}</li>)}
                </ul>
              </div>
            )}
            {champ.enemytips?.length > 0 && (
              <div class='dark:bg-black/30 bg-gray-100 rounded-lg border dark:border-gray-800 border-gray-200 p-5'>
                <h2 class='text-lg font-bold mb-2 text-red-500'>Consejos jugando contra {champ.name}</h2>
                <ul class='list-disc pl-5 text-sm text-gray-400 flex flex-col gap-2'>
                  {champ.enemytips.map(tip => <li>{tip}</li>)}
                </ul>
              </div>
            )}
          </div>
        )}

        {/* SKINS */}
        <div class='flex flex-col gap-3'>
          <h2 class='text-2xl font-bold'>Aspectos</h2>
          <div class='flex flex-row gap-5 w-full overflow-x-auto scrollbar scrollbar-thumb-indigo-700 pb-4'>
            {realSkins.map(skin => (
              <div class="flex flex-col gap-2 shrink-0">
                <div class="border border-yellow-300 rounded h-[210px] w-[120px] overflow-hidden">
                  <img
                    class='object-cover w-full h-full duration-300 hover:scale-110'
                    src={`${DDRAGON_IMG}/champion/loading/${champ.id}_${skin.num}.jpg`}
                    alt={`${champ.name} ${skin.name}`}
                    loading="lazy"
                  />
                </div>
                <p class='text-xs text-center text-gray-400 w-[120px] truncate'>{skin.name === 'default' ? champ.name : skin.name}</p>
              </div>
            ))}
          </div>
        </div>
      </Fragment>
      : <div class='flex justify-center py-20'><Spinner size={72} /></div>}
  </div>
</Layout>
