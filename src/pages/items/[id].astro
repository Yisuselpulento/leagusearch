---
import Layout from "../../layouts/Layout.astro";
import { fetchDataItems } from "../../services/champs";
import { DDRAGON_CDN } from "../../services/constants";

export async function getStaticPaths() {
  const items = await fetchDataItems()
  const byId = Object.fromEntries(items.map(i => [i.id, i]))
  const pick = (ids = []) => ids.map(fid => byId[fid]).filter(Boolean)
  return items.map(item => ({
    params: { id: item.id },
    props: {
      item,
      fromItems: pick(item.from),
      intoItems: pick(item.into),
    }
  }))
}

const { item, fromItems, intoItems } = Astro.props

// Traducción de las claves de stats de Data Dragon a etiquetas legibles.
const STAT_LABELS = {
  FlatHPPoolMod: { label: 'Vida', pct: false },
  FlatMPPoolMod: { label: 'Mana', pct: false },
  FlatPhysicalDamageMod: { label: 'Dano de ataque', pct: false },
  FlatMagicDamageMod: { label: 'Poder de habilidad', pct: false },
  FlatArmorMod: { label: 'Armadura', pct: false },
  FlatSpellBlockMod: { label: 'Resist. magica', pct: false },
  FlatHPRegenMod: { label: 'Regen. de vida', pct: false },
  FlatMovementSpeedMod: { label: 'Vel. movimiento', pct: false },
  PercentMovementSpeedMod: { label: 'Vel. movimiento', pct: true },
  PercentAttackSpeedMod: { label: 'Vel. ataque', pct: true },
  FlatCritChanceMod: { label: 'Prob. critico', pct: true },
  PercentLifeStealMod: { label: 'Robo de vida', pct: true },
}
const statList = Object.entries(item.stats ?? {})
  .filter(([key]) => STAT_LABELS[key])
  .map(([key, value]) => ({
    label: STAT_LABELS[key].label,
    value: STAT_LABELS[key].pct ? `+${Math.round(value * 100)}%` : `+${value}`,
  }))

const MAP_NAMES = { '11': 'Grieta del Invocador', '12': 'ARAM', '30': 'Arena' }
const maps = Object.entries(item.maps ?? {})
  .filter(([id, ok]) => ok && MAP_NAMES[id])
  .map(([id]) => MAP_NAMES[id])
---

<Layout title={item.name}>
  <div class='flex flex-col gap-6 w-full md:p-16 p-4 pt-20 max-w-[900px]'>
    <a class='hover:text-indigo-500 dark:text-white text-gray-800 text-lg w-fit' href='/items'>&larr; Atras</a>

    <div class='flex flex-col md:flex-row gap-6 items-start dark:bg-black/30 bg-gray-100 rounded-lg border dark:border-gray-800 border-gray-200 p-6'>
      <img
        class='border border-yellow-400 rounded w-[80px] h-[80px] shrink-0'
        src={`${DDRAGON_CDN}/img/item/${item.image.full}`}
        alt={item.name}
      />
      <div class='flex flex-col gap-3'>
        <h1 class='text-3xl font-bold'>{item.name}</h1>
        {item.plaintext && <p class='text-gray-500 dark:text-gray-400'>{item.plaintext}</p>}
        <div class='flex gap-4 text-sm flex-wrap'>
          <span class='text-yellow-400 font-bold'>Costo total: {item.gold?.total ?? 0}</span>
          {item.gold?.base != null && <span class='text-gray-400'>Combinar: {item.gold.base}</span>}
          <span class='text-gray-400'>Venta: {item.gold?.sell ?? 0}</span>
        </div>
        <div class='flex flex-wrap gap-2'>
          {item.tags?.map(tag => (
            <span class='text-xs px-2 py-1 rounded bg-blue-900 text-white'>{tag}</span>
          ))}
          {maps.map(m => (
            <span class='text-xs px-2 py-1 rounded bg-slate-700 text-white'>{m}</span>
          ))}
        </div>
      </div>
    </div>

    {statList.length > 0 && (
      <div class='dark:bg-black/30 bg-gray-100 rounded-lg border dark:border-gray-800 border-gray-200 p-6'>
        <h2 class='text-xl font-bold mb-3'>Estadisticas</h2>
        <div class='grid grid-cols-2 md:grid-cols-3 gap-2 text-sm'>
          {statList.map(s => (
            <div class='flex justify-between border-b dark:border-gray-800 border-gray-200 py-1'>
              <span class='text-gray-400'>{s.label}</span>
              <span class='font-bold text-green-500'>{s.value}</span>
            </div>
          ))}
        </div>
      </div>
    )}

    {fromItems.length > 0 && (
      <div class='dark:bg-black/30 bg-gray-100 rounded-lg border dark:border-gray-800 border-gray-200 p-6'>
        <h2 class='text-xl font-bold mb-3'>Se construye con</h2>
        <div class='flex flex-wrap gap-4'>
          {fromItems.map(comp => (
            <a href={`/items/${comp.id}`} class='flex flex-col items-center gap-1 w-[70px] hover:scale-105 transition' title={comp.name}>
              <img class='w-[50px] h-[50px] border border-blue-900 rounded' src={`${DDRAGON_CDN}/img/item/${comp.image.full}`} alt={comp.name} loading='lazy' />
              <span class='text-[11px] text-center text-gray-400 truncate w-full'>{comp.name}</span>
              <span class='text-[11px] text-yellow-400'>{comp.gold?.total}</span>
            </a>
          ))}
        </div>
      </div>
    )}

    {intoItems.length > 0 && (
      <div class='dark:bg-black/30 bg-gray-100 rounded-lg border dark:border-gray-800 border-gray-200 p-6'>
        <h2 class='text-xl font-bold mb-3'>Construye a</h2>
        <div class='flex flex-wrap gap-4'>
          {intoItems.map(build => (
            <a href={`/items/${build.id}`} class='flex flex-col items-center gap-1 w-[70px] hover:scale-105 transition' title={build.name}>
              <img class='w-[50px] h-[50px] border border-blue-900 rounded' src={`${DDRAGON_CDN}/img/item/${build.image.full}`} alt={build.name} loading='lazy' />
              <span class='text-[11px] text-center text-gray-400 truncate w-full'>{build.name}</span>
            </a>
          ))}
        </div>
      </div>
    )}

    {item.description && (
      <div
        class='dark:bg-black/20 bg-gray-100 rounded-lg border dark:border-gray-800 border-gray-200 p-6 leading-relaxed text-sm'
        set:html={item.description}
      />
    )}
  </div>
</Layout>
