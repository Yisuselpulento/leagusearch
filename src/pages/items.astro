---
import CardItems from "../components/CardItems.astro";
import FilterIcon from "../components/icons/FilterIcon.astro";
import Layout from "../layouts/Layout.astro";
import { fetchDataItems, getVersion } from "../services/champs";

const version = await getVersion()

// Solo items comprables de la Grieta del Invocador (mapa 11): quita el "junk"
// (items ocultos, de misiones, placeholders) que ensuciaba la grilla.
const rawItems = (await fetchDataItems()).filter(i =>
  i.gold?.purchasable && (i.gold?.total ?? 0) > 0 && i.maps?.['11']
)

// Asignación a categoría por tags (primer match gana; orden importa).
const ASSIGN = [
  ['boots',  t => t.includes('Boots')],
  ['consum', t => t.includes('Consumable')],
  ['vision', t => t.includes('Vision') || t.includes('Trinket')],
  ['ad',     t => ['CriticalStrike','AttackSpeed','Damage','LifeSteal','OnHit','ArmorPenetration'].some(x => t.includes(x))],
  ['ap',     t => ['SpellDamage','Mana','ManaRegen','CooldownReduction','AbilityHaste','MagicPenetration','SpellVamp'].some(x => t.includes(x))],
  ['def',    t => ['Armor','SpellBlock','Health','HealthRegen','Tenacity'].some(x => t.includes(x))],
]
const catOf = (item) => {
  const tags = item.tags ?? []
  for (const [key, fn] of ASSIGN) if (fn(tags)) return key
  return 'util'
}

const LABELS = { boots: 'Botas', ad: 'Daño físico', ap: 'Poder de habilidad', def: 'Defensa', util: 'Utilidad', consum: 'Consumibles', vision: 'Visión' }
const DISPLAY = ['boots', 'ad', 'ap', 'def', 'util', 'consum', 'vision']

const groups = DISPLAY.map(key => ({
  key,
  label: LABELS[key],
  items: rawItems
    .filter(i => catOf(i) === key)
    .sort((a, b) => (a.gold.total - b.gold.total)),
})).filter(g => g.items.length > 0)
---

<Layout title="items">
  <div class='flex flex-col gap-6 w-full md:p-24 p-3 pt-20 max-w-[1600px]'>
    <div class='max-w-[1000px]'>
      <p class='text-3xl font-bold'>League of Legends Items</p>
      <p class='text-lg dark:text-gray-400 text-gray-500'>Objetos de la Grieta del Invocador, agrupados por tipo y ordenados por costo.</p>
    </div>

    <div class='flex gap-3 items-center'>
      <FilterIcon class="size-6" />
      <p class='font-bold hidden md:block'>Filtrar</p>
      <input
        id='item-filter'
        type='search'
        class='border-1 block h-12 w-[300px] text-black rounded-md border border-double bg-gray-300 border-slate-800 border-transparent dark:bg-[linear-gradient(#000,#000),linear-gradient(to_right,#334454,#334454)] bg-origin-border px-3 py-2 dark:text-slate-200 transition-all duration-500 [background-clip:padding-box,_border-box] placeholder:text-slate-500 focus:bg-[linear-gradient(#ddd,#ddd),linear-gradient(to_right,#2344A1,#0A1B4B)] dark:focus:bg-[linear-gradient(#000,#000),linear-gradient(to_right,#2344A1,#0A1B4B)] focus:outline-none'
        placeholder='Buscar item...'
      />
    </div>

    <div class='flex flex-col gap-8'>
      {groups.map(g => (
        <section class='item-cat flex flex-col gap-3'>
          <h2 class='text-xl font-bold flex items-center gap-2 border-b dark:border-gray-800 border-gray-200 pb-2'>
            {g.label}
            <span class='text-sm text-gray-400 font-normal'>({g.items.length})</span>
          </h2>
          <div class='item-grid grid gap-3 content-start justify-start' style='grid-template-columns: repeat(auto-fill, 50px);'>
            {g.items.map(item => (
              <CardItems item={item} version={version} />
            ))}
          </div>
        </section>
      ))}
    </div>

    <p id='item-empty' class='hidden text-gray-400'>No se encontraron items.</p>
  </div>

  <script>
    document.addEventListener('astro:page-load', () => {
      const input = document.getElementById('item-filter')
      if (!input) return
      const cats = Array.from(document.querySelectorAll('.item-cat'))
      const empty = document.getElementById('item-empty')
      input.addEventListener('input', () => {
        const term = input.value.toLowerCase().trim()
        let total = 0
        cats.forEach(cat => {
          let visible = 0
          cat.querySelectorAll('.item-card').forEach(card => {
            const match = (card.getAttribute('data-name') || '').includes(term)
            card.style.display = match ? '' : 'none'
            if (match) visible++
          })
          cat.style.display = visible ? '' : 'none'
          total += visible
        })
        if (empty) empty.classList.toggle('hidden', total !== 0)
      })
    })
  </script>
</Layout>
