---
import { ddImg } from "../services/constants"

const { item, version } = Astro.props
---

<a
class="item-card relative border border-blue-900"
data-name={item.name?.toLowerCase()}
href={`/items/${item.id}`}
title={item.name}
>
<img
  class='w-[50px] h-[50px] absolute'
  src={ddImg(version, 'item', item.image.full)}
  alt={item.name}
  loading="lazy"
/>
<div class="relative cursor-pointer size-[50px] overflow-hidden  before:bg-gradient-to-r before:from-white before:to-gray-700  before:w-[96px] before:h-[130px] before:absolute before:rotate-12 before:opacity-10 before:top-0 before:right-0 transition before:duration-200  before:translate-x-[100px] hover:before:-translate-y-7 hover:before:translate-x-[10px] "></div>
</a>
