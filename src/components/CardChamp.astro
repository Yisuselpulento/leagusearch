---
import { DDRAGON_CDN } from "../services/constants"
import FavoriteButton from "./FavoriteButton"

const { champ } = Astro.props
---

    <div class="champ-card" data-name={champ.toLowerCase()}>
         <a
         class="flex flex-row md:flex-col md:gap-2 gap-4 bg-blue-950 md:bg-transparent  p-1 rounded-lg relative"
            href={`../champs/${champ}`}
          >
          <img
            class='md:w-[80px] w-[80px] absolute'
            src={`${DDRAGON_CDN}/img/champion/${champ}.png`}
            alt={champ}
            loading="lazy"
          />
          <div class="relative cursor-pointer size-[80px] overflow-hidden  before:bg-gradient-to-r before:from-white before:to-gray-700  before:w-[96px] before:h-[130px] before:absolute before:rotate-12 before:opacity-10 before:top-0 before:right-0 transition before:duration-200  before:translate-x-[100px] hover:before:-translate-y-7 hover:before:translate-x-[10px] "></div>
          <p>{champ}</p>


          </a>

      <FavoriteButton champ={champ} client:visible />
    </div>
