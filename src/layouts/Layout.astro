---
import '@fontsource-variable/onest';
import Footer from '../components/Footer.astro';
import NavBar from '../components/NavBar.astro';
import Spinner from '../components/Spinner.astro';
import { ViewTransitions } from 'astro:transitions';
interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en" class="dark">
	
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Astro description" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/webp" href="/MonssterLogo.webp" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<ViewTransitions />
	</head>
	
	<body class=" dark:text-white  bg-white dark:bg-slate-950 text-gray-800 relative flex justify-center flex-col items-center">
		<div class="absolute left-0 right-0 top-0 -z-10 h-72 bg-white dark:bg-gradient-to-b dark:from-black from-10% dark:to-slate-950"></div>
			<div id="page-loader" class="fixed inset-0 z-[100] hidden items-center justify-center bg-white/70 dark:bg-black/70 backdrop-blur-sm">
				<Spinner size={72} />
			</div>
			<NavBar />
			<slot />
			<Footer />
		</body>
</html>
<script>
	// Spinner azul de transición entre páginas (ViewTransitions).
	// Se muestra al empezar a cargar la siguiente página y se oculta al terminar.
	const loaderShow = () => {
		const el = document.getElementById('page-loader');
		if (!el) return;
		el.classList.remove('hidden');
		el.classList.add('flex');
	};
	const loaderHide = () => {
		const el = document.getElementById('page-loader');
		if (!el) return;
		el.classList.add('hidden');
		el.classList.remove('flex');
	};
	document.addEventListener('astro:before-preparation', loaderShow);
	document.addEventListener('astro:after-swap', loaderHide);
	document.addEventListener('astro:page-load', loaderHide);
</script>

<style is:global>
	:root {
		color-scheme: dark light;
	}
	html {
		font-family: 'Onest Variable', sans-serif;
	}

</style>

